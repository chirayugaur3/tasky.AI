# Copy this file to .env.local and fill in real values.

# --- Database ---
# Local dev (Docker Compose): postgresql://ethara:ethara_dev_pw@localhost:5433/ethara_ai?schema=public
# Railway/Production: copy the Railway-provided Postgres URL.
DATABASE_URL=""

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (optional) ---
# https://console.cloud.google.com/apis/credentials
# Authorized redirect: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Groq API (EOD report generation) ---
# https://console.groq.com/keys
GROQ_API_KEY=""
